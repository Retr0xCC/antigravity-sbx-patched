# ========================================================
# SBX Workspace Environment Variables (.env)
# ========================================================

# Model & Provider Configuration (Antigravity & OpenCode)
GEMINI_API_KEY=""
MODEL_PROVIDER="gemini"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENCODE_API_KEY=""

# Workspace Settings
AGY_CLI_DISABLE_AUTO_UPDATE="true"
PYTHONUNBUFFERED="1"

# Port Forwarding Defaults
WORKSPACE_PORT="8080"
JUPYTER_PORT="8888"

# Local Crawl4AI & SearXNG MCP (via host.docker.internal)
SEARXNG_MCP_URL="http://host.docker.internal:3000/mcp"
CRAWL4AI_URL="http://host.docker.internal:11235"
CRAWL4AI_API_TOKEN=""
